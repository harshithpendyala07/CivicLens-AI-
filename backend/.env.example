# ============================================================
# CivicLens AI — Backend Environment Variables
# Flagsmith Hackathon Security Configuration
# ============================================================

# Secret key used for signing JWT tokens (min 256 bits for HMAC-SHA256)
# Default development fallback is provided, override in production:
JWT_SECRET=CivicLensAI_Flagsmith_Hackathon_SuperSecret_JWT_Key_2026_ChangeMeInProd

# Google Gemini API key for multimodal image analysis (pothole & damage triage)
# Leave empty to use intelligent zero-shot heuristic fallback:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Production MySQL connection (default is zero-config in-memory H2)
# DB_USERNAME=root
# DB_PASSWORD=your_password
